{
  "name": "sk-web-gui",
  "private": true,
  "version": "1.0.0",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "description": "",
  "main": "",
  "directories": {},
  "scripts": {
    "clean": "lerna clean --yes && rimraf node_modules",
    "clean:dist": "yarn lerna exec rimraf dist",
    "boot": "yarn && yarn build:nocache",
    "boot:esm": "yarn && yarn build:esm:nocache",
    "boot:storybook": "yarn && lerna run build:esm --no-private --stream --skip-nx-cache && lerna run build:cjs --no-private --stream --skip-nx-cache && yarn build:storybook",
    "reboot": "yarn clean:dist | yarn cache clean && yarn boot",
    "dev": "yarn dev-storybook",
    "lerna-watch": "lerna watch -- lerna run build --verbose --scope=%LERNA_PACKAGE_NAME%",
    "build": "cross-env SWC_CACHE=1 yarn build:types && yarn build:esm && yarn build:cjs",
    "build:nocache": "cross-env SWC_CACHE=0 nx reset && yarn build:types && yarn build:esm:nocache && yarn build:cjs:nocache",
    "build:lerna": "lerna run build --no-private --stream",
    "build:lerna:nocache": "cross-env SWC_CACHE=0 nx reset && yarn build:lerna --skip-nx-cache",
    "build:types": "lerna run build:types --no-private --stream",
    "build:esm": "lerna run build:esm --no-private --stream",
    "build:esm:nocache": "yarn build:esm --skip-nx-cache",
    "build:cjs": "lerna run build:cjs --no-private --stream",
    "build:cjs:nocache": "yarn build:cjs --skip-nx-cache",
    "build:storybook": "storybook build -o ./storybook-static",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:next": "rimraf test-fixtures/next-security/.next && next build test-fixtures/next-security",
    "test:storybook": "vitest run --project=storybook",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:ci": "yarn lint && yarn test:coverage && yarn build && yarn test:package-contents && yarn test:ai-consumer && yarn test:next && yarn test:storybook && yarn build:storybook",
    "test:ai-consumer": "node scripts/verify-ai-consumer.mjs",
    "test:package-contents": "node scripts/verify-package-contents.mjs",
    "start": "yarn storybook",
    "storybook": "storybook dev -p 6006",
    "dev-storybook": "cross-env NODE_ENV=development storybook dev -p 6006 --no-open",
    "mcp:manifest": "node mcp-server/generate-manifest.mjs",
    "mcp:install": "npm ci --prefix mcp-server",
    "mcp:serve": "yarn mcp:manifest && npm start --prefix mcp-server",
    "security:audit": "yarn audit --level low",
    "release": "lerna publish from-git",
    "link-all": "yarn unlink-all && lerna exec --parallel yarn link",
    "unlink-all": "lerna exec --parallel --bail=false yarn unlink",
    "lint": "eslint ./packages",
    "prepare": "husky"
  },
  "resolutions": {
    "**/react": "^19.1.1",
    "**/react-dom": "^19.1.1",
    "**/handlebars": "4.7.9",
    "**/lerna/js-yaml": "4.2.0",
    "**/lerna/tar": "7.5.19",
    "**/microsoft-cognitiveservices-speech-sdk/uuid": "11.1.1",
    "**/next/postcss": "8.5.16",
    "**/storybook/esbuild": "0.28.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.3",
    "cross-env": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "10.5.0",
    "esbuild": "0.28.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lerna": "9.0.7",
    "next": "15.5.20",
    "nx": "22.7.6",
    "playwright": "^1.58.0",
    "postcss": "^8.5.16",
    "postcss-import": "^16.1.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rimraf": "^6.1.3",
    "sass": "^1.101.0",
    "storybook": "10.5.0",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.63.0",
    "vite": "8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dotenv": "^17.2.1",
    "react-hook-form": "^7.62.0"
  },
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "packageManager": "yarn@1.22.22",
  "repository": "https://github.com/Sundsvallskommun/web-shared-components.git",
  "author": "Sundsvallskommun"
}
