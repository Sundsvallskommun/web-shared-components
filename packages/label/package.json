{
  "name": "@sk-web-gui/label",
  "version": "1.1.2",
  "sideEffects": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "start": "nodemon --watch src --exec yarn build -e ts,tsx",
    "build": "yarn build:types && yarn build:esm && yarn build:cjs",
    "test": "node ../../scripts/test-package-tests.mjs",
    "lint": "concurrently yarn:lint:*",
    "version": "yarn build",
    "build:esm": "node ../../scripts/build-package.mjs esm",
    "build:cjs": "node ../../scripts/build-package.mjs cjs",
    "build:types": "tsc -p ./tsconfig.production.json --emitDeclarationOnly --declaration --declarationDir dist/types",
    "test:cov": "node ../../scripts/test-package-tests.mjs --coverage",
    "lint:src": "eslint src"
  },
  "devDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@sk-web-gui/utils": "2.2.2"
  },
  "peerDependencies": {
    "react": ">=18.3.1"
  }
}
