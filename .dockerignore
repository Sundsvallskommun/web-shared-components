# Credentials and local configuration must never enter the build context
.env*
*.pem
*.key
.npmrc
.yarnrc
.yarnrc.yml

# Installed dependencies and package-manager state
**/node_modules
.npm
.pnp
.pnp.*
.yarn/cache
.yarn/unplugged
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated outputs and caches
**/coverage
**/dist
storybook-static
.next
.nx
.turbo
*.tsbuildinfo
mcp-server/manifest.json
playwright-report
test-fixtures
test-results

# Local tools and operating-system files
.DS_Store
.idea
.vscode
*.swp
